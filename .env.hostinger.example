# Paste these (filled in) into Hostinger → VPS → Docker Manager → your project → Environment.
# Used with compose.hostinger.yaml. Never commit the filled-in copy.

# Domains — point both DNS A records at the VPS IP before deploying
APP_DOMAIN=bosshegzrealty.com
PMA_DOMAIN=pma.bosshegzrealty.com
ACME_EMAIL=admin@bosshegzrealty.com

# The image on Docker Hub (built from the prod branch)
APP_IMAGE=clintonace09/bossheggz:prod

# App key — generate with: docker run --rm clintonace09/bossheggz:prod php artisan key:generate --show
APP_KEY=

# Database
DB_DATABASE=seggzapp
DB_USERNAME=seggzapp
DB_PASSWORD=
DB_ROOT_PASSWORD=

# phpMyAdmin extra login. Hash: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes (the hash contains $ signs).
PMA_AUTH_USER=dbadmin
PMA_AUTH_HASH=''

# First admin account (created by: php artisan db:seed --force)
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email for engagement and enquiry updates
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@bosshegzrealty.com

# Business details
COMPANY_PHONE="+2348111708068"
COMPANY_WHATSAPP=2348111708068
COMPANY_EMAIL=bosshegz@yahoo.com
COMPANY_INSTAGRAM=bosshegzrealty
COMPANY_ADDRESS=

# Backups (kept in the project's backups folder on the VPS)
BACKUP_KEEP_DAYS=14

# SeggzApp production settings — copy to .env.production on the server and fill in.
# Used by: docker compose -f compose.production.yaml --env-file .env.production up -d --build
# Never commit .env.production.

#################### Domains & HTTPS (Caddy) ####################
# Point both DNS records (A/AAAA) at the server first. Certificates are automatic.
APP_DOMAIN=bosshegzrealty.com
PMA_DOMAIN=pma.bosshegzrealty.com
ACME_EMAIL=admin@bosshegzrealty.com
HTTP_PORT=80
HTTPS_PORT=443

# Extra login in front of phpMyAdmin (then you sign in with the MySQL user/password).
# Make the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-strong-password'
# Keep the single quotes — the hash contains $ signs.
PMA_AUTH_USER=dbadmin
PMA_AUTH_HASH='paste-the-hash-here'

#################### Docker image ####################
# The live image on Docker Hub (built from the prod branch). Use a version tag such as
# clintonace/bossheggz:prod-150446a to pin a release, or leave as :prod for the newest.
APP_IMAGE=clintonace/bossheggz:prod

#################### App ####################
APP_NAME="BOSSHEGZ Realty"
APP_ENV=production
# Generate once with: docker run --rm clintonace/bossheggz:prod php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://bosshegzrealty.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs go to the container output: docker compose -f compose.production.yaml logs -f app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

#################### First admin account ####################
# Created by "php artisan db:seed --force" when no admin exists yet. You can leave these
# empty and run: docker compose -f compose.production.yaml --env-file .env.production exec app php artisan app:make-admin you@yourdomain.com
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Live sites start without demo data. Add it any time from Admin → Data manager.
SEED_DEMO_DATA=false

#################### Database (MySQL) ####################
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=seggzapp
DB_USERNAME=seggzapp
DB_PASSWORD=change-me-to-a-long-random-password
DB_ROOT_PASSWORD=change-me-to-another-long-random-password

#################### Sessions, cache & queue (Redis) ####################
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

#################### Email (engagement & enquiry updates) ####################
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@bosshegzrealty.com"
MAIL_FROM_NAME="${APP_NAME}"

#################### Backups ####################
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

#################### Business details ####################
LISTING_CURRENCY="₦"
COMPANY_NAME="BOSSHEGZ Realty"
COMPANY_LEGAL_NAME="BOSSHEGZ Realty Ltd"
COMPANY_TAGLINE="Strategic Property. Lasting Wealth."
COMPANY_PHONE="+2348111708068"
COMPANY_WHATSAPP=2348111708068
COMPANY_EMAIL=bosshegz@yahoo.com
COMPANY_INSTAGRAM=bosshegzrealty
COMPANY_ADDRESS=

# The "Test accounts" login switcher must stay off on a live site.
DEV_ACCOUNT_SWITCHER=false
